rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInWithVerifiedEmail() {
      return request.auth != null
        && request.auth.token.get('email', null) != null
        && request.auth.token.get('email_verified', false) == true;
    }

    function rootAdmin() {
      return signedInWithVerifiedEmail()
        && request.auth.token.email == "sehyun.ka@gmail.com";
    }

    function listedAdmin() {
      return signedInWithVerifiedEmail()
        && exists(/databases/$(database)/documents/adminAccess/$(request.auth.token.email))
        && get(/databases/$(database)/documents/adminAccess/$(request.auth.token.email)).data.active == true;
    }

    function isAdmin() {
      return rootAdmin() || listedAdmin();
    }

    // 직원은 Cloud Function(employeeLogin)이 발급한 사용자 지정 토큰으로 로그인합니다.
    // 토큰에는 role=employee 와 본인 계정 ID(aid)가 들어 있습니다.
    // 직원 로그인은 30일(2,592,000초) 동안만 유효합니다. 이후에는 비밀번호를 다시 입력해야 합니다.
    function isEmployee() {
      return request.auth != null
        && request.auth.token.get('role', '') == 'employee'
        && request.auth.token.get('auth_time', 0) > request.time.toMillis() / 1000 - 2592000
        && request.auth.token.get('aid', '') is string
        && request.auth.token.get('aid', '') != '';
    }

    // 요청자가 해당 직원 본인인지 확인합니다.
    function isMe(aid) {
      return isEmployee() && aid is string && request.auth.token.aid == aid;
    }

    // 관리자(Google 인증) 또는 로그인한 직원만 허용합니다. 임의의 Google 계정은 허용하지 않습니다.
    function signedIn() {
      return isAdmin() || isEmployee();
    }

    // 가세현 최초 관리자만 다른 관리자 Google 계정을 등록·변경할 수 있습니다.
    match /adminAccess/{email} {
      allow read: if isAdmin();
      allow create, update, delete: if rootAdmin();
    }

    // 감사 로그는 인증된 관리자만 추가·조회할 수 있으며 영구적으로 수정·삭제를 거부합니다.
    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.adminEmail == request.auth.token.email
        && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }

    // 설정·차량·공지·사용자 표시 정보는 로그인한 사용자만 읽고, 변경은 관리자만 합니다.
    match /settings/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /vehicles/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /notices/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    // users: 계정(accounts)에서 복사한 비밀번호 없는 표시 정보(이름·부서·지정 차량·공용차량 권한)
    match /users/{documentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // 계정 원본(비밀번호 해시 포함)은 관리자만 접근합니다. 직원 로그인·비밀번호 변경은
    // Cloud Functions(employeeLogin / changePassword / adminSetPassword)에서만 처리합니다.
    match /accounts/{documentId} {
      allow read, write: if isAdmin();
    }

    // 직원 본인의 비밀번호 상태(initial/changed). 기록은 Cloud Functions만 합니다.
    match /accountStatus/{aid} {
      allow read: if isAdmin() || isMe(aid);
      allow write: if false;
    }

    // 로그인 실패 횟수·잠금 정보는 클라이언트에서 접근할 수 없습니다.
    match /loginFails/{documentId} {
      allow read, write: if false;
    }

    // 직원은 본인 명의(uid)로만 운행을 시작하고, 본인 운행의 종료 필드만 채울 수 있습니다.
    // 전체 기록 수정·삭제는 Google 인증 관리자만 가능합니다.
    match /trips/{documentId} {
      allow read: if signedIn();
      allow create: if isAdmin() || isMe(request.resource.data.uid);
      allow update: if isAdmin()
        || (isMe(resource.data.uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['endKm', 'dist', 'endDate', 'endTime', 'status',
              'lastReportedKm', 'lastReminderResponseAt', 'reminderAction',
              'reminderNextHour', 'reminderActionAt']));
      allow delete: if isAdmin();
    }

    // 로그인한 직원은 본인 기기 토큰만 최소 필드로 등록·갱신합니다(공용 기기는 aid 재지정 허용).
    // 토큰 전체 조회·삭제는 Google 인증 관리자만 가능합니다.
    match /pushTokens/{tokenId} {
      allow read, delete: if isAdmin();
      allow create, update: if isMe(request.resource.data.aid)
        && request.resource.data.keys().hasOnly(['token','aid','name','dept','active','updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.active == true;
    }

    // 직원은 본인 명의(uid)의 정비 기록만 등록하고, 저장 후 수정·삭제는 관리자만 허용합니다.
    match /maintenance/{documentId} {
      allow read: if signedIn();
      allow create: if isAdmin() || isMe(request.resource.data.uid);
      allow update, delete: if isAdmin();
    }

    // 휴가(연차) 기록입니다. 직원 본인(당일 팝업·사전 등록)과 관리자가 등록하며, 시작 알림 제외와
    // 주간 점검 제외, 운행 기록 휴가 표시에 사용합니다. 본인 등록분(by=self)은 직원이 취소할 수 있습니다.
    match /selfHolidayReports/{documentId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (isMe(request.resource.data.aid)
        && request.resource.data.keys().hasOnly(['aid','name','dept','date','reportedAt','kind','by'])
        && request.resource.data.date is string
        && request.resource.data.by == 'self'
        && documentId == request.resource.data.aid + '_' + request.resource.data.date);
      allow update: if isAdmin()
        || (isMe(resource.data.aid)
        && request.resource.data.aid == resource.data.aid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedAt','kind','by'])
        && request.resource.data.by == 'self');
      allow delete: if isAdmin() || (isMe(resource.data.aid) && resource.data.get('by', '') == 'self');
    }

    // 시작 알림(08·09·10시) 발송 이력입니다. Cloud Functions(Admin SDK)에서만
    // 기록하며 클라이언트의 직접 쓰기는 허용하지 않습니다.
    match /startReminderDeliveries/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 매주 월요일 08시 개인별 습관 점검 알림 발송 이력입니다. Cloud
    // Functions(Admin SDK)에서만 기록합니다.
    match /weeklyReportDeliveries/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // [usage-20261021] 접속 기록(하루·직원당 1문서). 직원은 본인 문서만 +1, 조회는 관리자만, 삭제 불가.
    function usageOk(docId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['day','aid','name','dept','opens','hours','last','mode','device'])
        && d.aid == request.auth.token.aid
        && d.day is string && d.day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && docId == d.day + '_' + d.aid
        && d.last == request.time
        && d.hours is map && d.hours.size() <= 24
        && d.name is string && d.name.size() <= 40 && d.dept is string && d.dept.size() <= 40;
    }
    match /usageDaily/{docId} {
      allow read: if isAdmin();
      allow create: if isEmployee() && usageOk(docId) && request.resource.data.opens == 1;
      allow update: if isEmployee() && usageOk(docId) && resource.data.aid == request.auth.token.aid
        && request.resource.data.opens == resource.data.opens + 1;
      allow delete: if false;
    }
  }
}
